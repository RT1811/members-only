<!DOCTYPE html>
<html>
<head><title>Messages</title></head>
<body>
  <h1>Messages</h1>

  <% if (currentUser) { %>
    <a href="/messages/new">New Message</a>
  <% } %>

  <% messages.forEach(function(message) { %>
    <div>
      <h3><%= message.title %></h3>
      <p><%= message.text %></p>
      <% if (currentUser && (currentUser.membership_status === "member" || currentUser.is_admin)) { %>
        <p>
          By <%= message.first_name ? `${message.first_name} ${message.last_name}` : "Unknown" %>
          on <%= message.created_at.toDateString() %>
        </p>
      <% } else { %>
        <p>on <%= message.created_at.toDateString() %></p>
      <% } %>
    </div>
  <% }) %>
</body>
</html>